{
  "name": "irctc-chart-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Live IRCTC Online Charts data-access layer with a Vite/React/Tailwind/shadcn-ui frontend.",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "chart": "node src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/*.test.ts",
    "dev": "vite --config frontend/vite.config.ts",
    "build": "npm run typecheck:frontend && vite build --config frontend/vite.config.ts",
    "preview": "vite preview --config frontend/vite.config.ts",
    "typecheck:frontend": "tsc -p frontend/tsconfig.json"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.48.0",
    "react": "^18.2.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  }
}
